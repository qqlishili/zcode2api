# zcode-hub 环境变量样例 —— 复制为 .env 后按需修改；.env 永不入库

# ── 服务 ──
ZCODE_PORT=3000
ZCODE_HOST=0.0.0.0
ZCODE_DATA_DIR=data

# ── 鉴权 ──
# 后台管理密码（首次启动写入 meta 表，之后以数据库为准）
ZCODE_ADMIN_KEY=change-me
# 网关 API Key 留空 = 不校验（生产务必设置）
#ZCODE_GATEWAY_KEY=

# ── 上游（一般无需改动）──
# 默认值取自 app/constants.py 的 MESSAGES_URLS / USER_AGENT；下列注释值即其当前值。
# ZAI_UPSTREAM_URL=https://zcode.z.ai/api/v1/zcode-plan/anthropic/v1/messages
# ZAI_FALLBACK_URL=https://api.z.ai/api/anthropic/v1/messages
# BIGMODEL_UPSTREAM_URL=https://open.bigmodel.cn/api/anthropic/v1/messages
# UPSTREAM_USER_AGENT=ZCode/3.0.1
# OAuth 与事件上报端点（默认由 constants 推导）
# ZCODE_OAUTH_API_BASE=
# ZCODE_EXCHANGE_ORIGIN=
# ZCODE_EVENT_REPORT_URL=

# ── 请求通道（上游请求「形态」的来源）──
# native = 本仓库手写拼装；plugin = 官方插件经插件宿主组装（见 docs/adr/0001-*.md）
# 单请求只走一条，不做并行/主备。
#ZCODE_REQUEST_CHANNEL=plugin
# 插件宿主运行时。默认交给 PATH 解析（bun 的安装位置与家目录无关）；
# 如 PATH 中没有 bun，再指向其绝对路径。
#ZCODE_BUN_PATH=
# 插件宿主脚本与插件目录。默认取项目内 vendor/（随仓库与子模块分发），
# 需要指向外部仓库调试时再覆盖。
#ZCODE_PLUGIN_HOST_JS=vendor/magpie_host.js
#ZCODE_PLUGIN_DIR=vendor/magpie-plugins/packages/zcode

# ── 多出口代理（mihomo 中继）──
# 出口模式：proxy = 用账号绑定大区的代理；direct = 强制直连。
#ZCODE_EGRESS_MODE=proxy
# 出口端口列表（逗号分隔）。由 scripts/mihomo_auto_probe.py 依订阅自动回写，
# 通常无需手填；手填时须与 mihomo listeners 的端口一致。
#ZCODE_PROXIES=
# 机场订阅源（逗号分隔）。每项可为 https:// 订阅链接，或本地 .yaml 配置路径
# （机房拉不动的机场可先把配置落到本地再指向它）。
# 该脚本由 systemd timer 周期运行；订阅与节点仅在本机与 VPS 之间流转，不入库。
#AIRPORT_SUB_URLS=
# mihomo 侧路径（一般沿用系统约定，无需设置）
#MIHOMO_CONFIG_PATH=/etc/mihomo/config.yaml
#MIHOMO_CONTROLLER_URL=http://127.0.0.1:9090
# 探针用的临时回环端口；不设则动态分配
#MIHOMO_PROBE_PORT=

# ── 验证码求解（Node 子进程）──
# 默认 "node"（走 PATH）；仅在 PATH 中没有 node 时才需指向绝对路径。
ZCODE_NODE_PATH=node
# ZCODE_CAPTCHA_RETRIES=4
# ZCODE_CAPTCHA_TIMEOUT=25
# CAPTCHA_CACHE_TTL=45000
# 预解池：预热域固定为「可服务账号实际绑定的出口端口」，水位是每端口 1 枚
# CAPTCHA_REGIONAL_POOL_MIN=1
# CAPTCHA_REGIONAL_POOL_MAX=5
# 端口级求解退避（同端口连续失败阈值 / 基础冷却秒数，实际窗口含 0.75~1.5 抖动）
# CAPTCHA_PORT_FAIL_THRESHOLD=2
# CAPTCHA_PORT_COOLDOWN=60

# ── 落盘证据（data/evidence.db）──
# ZCODE_EVIDENCE_ENABLED=1
# ZCODE_EVIDENCE_RETENTION_DAYS=7

# ── 额度监控 ──
# ZCODE_QUOTA_REFRESH_INTERVAL=60
# ZCODE_COOLING_SECONDS=300

# ── 账号并发 ──
# 单账号并发上限（0 = 不限）；运行时可在后台设置改，以库为准
# ZCODE_ACCOUNT_CONCURRENCY=2

# ── 设备身份（上游指纹仿真；默认按运行平台推导，一般无需设置）──
# 覆盖后须与账号入池时登记的指纹一致，否则上游可能判为异常。
# ZCODE_IDENTITY_PLATFORM=darwin
# ZCODE_IDENTITY_ARCH=arm64
# ZCODE_IDENTITY_RELEASE=
# ZCODE_IDENTITY_RELEASE_CHANNEL=
# ZCODE_IDENTITY_CLIENT_LANGUAGE=zh-CN
# ZCODE_IDENTITY_CLIENT_TIMEZONE=Asia/Shanghai
# ZCODE_IDENTITY_DEVICE_MID=          # 留空则读取 data/device_mid

# ── 告警（Bark）──
# DEVICE_KEY 留空 = 关闭告警。SERVER_URL 默认 https://api.day.app
# ZCODE_BARK_SERVER_URL=https://api.day.app
# ZCODE_BARK_DEVICE_KEY=

# ── 秘钥类（不落盘、不入日志）──
# ZSW_PASSWORD=            # .zsb 导出口令（与 zcode-switch 脚本兼容）
# ZCODE_BUNDLE_PASSWORD=   # 备选口令变量
# ZCODE_MASTER_SECRET=     # M1：凭证落库加密主秘钥
